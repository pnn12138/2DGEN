# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv
.uv_cache/

# Dataset cache / generated data
# Ignore top-level `data/*` by default, then selectively unignore curated subsets.
data/*
P_TASK/data/
!2DGEN/data/
!2DGEN/data/**
2DGEN/data/**/*.pyc
2DGEN/data/**/__pycache__/

# Allow tracking curated sample data under repo `data/C2DB`
!data/C2DB/
!data/C2DB/**
!data/ref_energies.json

# Generated C2DB outputs/caches
data/C2DB/clean/
data/C2DB/cache/

# Training / experiment outputs
outputs/
runs/
P_TASK/outputs/
lightning_logs/
logs/
*.log

# Model checkpoints / tensors (do not commit)
*.pt
*.pth
*.ckpt
*.safetensors
*.npz
*.bin

# Vendored/third-party large repos
model/mattergen/

# OS/editor noise
.DS_Store
.idea/
.vscode/
